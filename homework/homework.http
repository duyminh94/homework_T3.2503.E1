Cốc sứ trắng
--WebAppBoundary
Content-Disposition: form-data; name="inspectorId"

1
--WebAppBoundary
Content-Disposition: form-data; name="image"; filename="good.jpg"
Content-Type: image/jpeg

< ../samples/good.jpg
--WebAppBoundary--

